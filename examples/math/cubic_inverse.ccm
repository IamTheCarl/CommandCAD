# Cubic inverse solver examples.
#
# When the expression is a polynomial of degree 3 (ax^3 + bx^2 + cx + d),
# the solver uses Cardano's formula to find the real root.

[
  # Pure cubing: f(x) = x*x*x = volume
  # Given: result = 27 m^3
  # Inverse: x = cbrt(27) = 3m
  let f = (x: std.scalar.Length) -> std.scalar.Volume: x * x * x; in
    f::inverse(wanted_output = "x")(27'm^3'),

  # Cubing with offset: f(x) = x*x*x + 1 m^3
  # Given: result = 28 m^3
  # Inverse: x = cbrt(28 - 1) = cbrt(27) = 3m
  let g = (x: std.scalar.Length) -> std.scalar.Volume: x * x * x + 1'm^3'; in
    g::inverse(wanted_output = "x")(28'm^3'),

  # Full cubic: f(x) = x*x*x + 3*x*x + 3*x + 1 (i.e., (x+1)^3)
  # Given: result = 64 m^3
  # Inverse: x = cbrt(64) - 1 = 4 - 1 = 3m
  let h = (x: std.scalar.Length) -> std.scalar.Volume:
    x * x * x + 3 * x * x + 3 * x + 1; in
    h::inverse(wanted_output = "x")(64'm^3'),

  # Kinematic equation: d = v*t + 0.5*a*t^2 (solve for acceleration)
  # Given: distance = 100m, velocity = 10m/s, time = 5s
  # Inverse: a = 2*(100 - 10*5) / 25 = 0 m/s^2
  let kinematic_distance = (v: std.scalar.Velocity, a: std.scalar.Acceleration, t: std.scalar.Time) -> std.scalar.Length:
    v * t + 0.5 * a * t * t; in
    kinematic_distance::inverse(wanted_output = "a")(
      v = 10m/1s, t = 5s, original_result = 100m
    ),
]
